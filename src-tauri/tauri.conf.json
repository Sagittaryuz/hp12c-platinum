{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HP 12c Platinum",
  "version": "0.1.0",
  "identifier": "com.sagittaryuz.hp12cplatinum",
  "build": {"beforeDevCommand":"npm run dev","devUrl":"http://localhost:5173","beforeBuildCommand":"npm run build:tauri","frontendDist":"../dist/client"},
  "app": {
    "windows": [{"title":"HP 12c Platinum","width":1320,"height":930,"minWidth":720,"minHeight":640}],
    "security": {"csp":"default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self';"}
  },
  "bundle": {
    "active": true, "targets":["nsis"], "copyright":"Copyright © 2026 Sagittaryuz. Todos os direitos reservados.",
    "shortDescription":"Calculadora financeira independente", "icon":["icons/icon.ico","icons/icon.png"],
    "windows":{"nsis":{"displayLanguageSelector":true,"languages":["PortugueseBR","English"],"installMode":"currentUser"}}
  }
}
